# 운영(seogo) systemd 유닛. /etc/systemd/system/oprn-store.service 로 복사한다.
[Unit]
Description=OPRN asset store
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
User=oprn-store
Group=oprn-store
WorkingDirectory=/opt/oprn-store
EnvironmentFile=/etc/oprn-store/store.env
Environment=STORE_MIGRATIONS_DIR=/opt/oprn-store/migrations STORE_PUBLIC_DIR=/opt/oprn-store/public
ExecStart=/usr/bin/node /opt/oprn-store/dist/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/oprn-store

[Install]
WantedBy=multi-user.target
