# /etc/oprn-store/store.env (chmod 600, owner oprn-store). 비밀값은 저장소에 커밋하지 않는다.
STORE_PORT=8794
STORE_HOST=127.0.0.1
STORE_PUBLIC_URL=https://store.openrpgmaker.com
STORE_DATABASE_URL=postgresql://oprn-store@localhost/oprn_store?host=/var/run/postgresql
STORE_BLOB_DIR=/var/lib/oprn-store/blobs
STORE_ADMIN_EMAILS=admin@openrpgmaker.com
STORE_CONTACT_EMAIL=admin@openrpgmaker.com
STORE_TRUST_PROXY=1
STORE_SECRET=<openssl rand -hex 32>
STORE_MIGRATIONS_DIR=/opt/oprn-store/migrations
STORE_PUBLIC_DIR=/opt/oprn-store/public
# Google 로그인을 열 때 두 줄을 채우고 재시작한다.
# STORE_GOOGLE_CLIENT_ID=<Google Cloud OAuth 클라이언트 ID>
# STORE_GOOGLE_CLIENT_SECRET=<Google Cloud OAuth 클라이언트 보안 비밀>
# 운영에서는 절대 켜지 않는다: STORE_DEV_LOGIN=1
