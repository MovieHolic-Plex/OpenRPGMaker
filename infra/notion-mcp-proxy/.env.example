# Keep the real values only on MDC in /home/main/notion-mcp-proxy/.env (chmod 600).
NOTION_TOKEN=secret_replace_me

# The server is deliberately bound to the Tailscale interface, never 0.0.0.0.
BIND_HOST=100.73.251.77
PORT=8788
MCP_HOSTNAME=100.73.251.77

# Comma-separated IPv4 CIDRs. Use /32 for a single device.
# Tailscale VPS fleet only. Workstation and mobile nodes are intentionally omitted.
ALLOWED_CIDRS=100.100.92.39/32,100.91.237.118/32,100.81.244.65/32,100.78.11.98/32,100.79.240.26/32,100.69.185.100/32,100.115.27.71/32,100.99.190.53/32,100.126.8.51/32,100.98.242.76/32,100.104.224.40/32,100.102.0.25/32
