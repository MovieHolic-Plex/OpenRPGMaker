// C: 높이만 28px에서 16px로 압축, 안장 윗면 3행·남쪽 면 1행과 접지선 y=31 보존.
@size 16 32
@cell 16
@palette palette.pal
@mat A linen 2
@mat B linen 3
@mat C linen 5
@mat D linen 6
@mat E pine 1
@mat F pine 3
@mat G pine 4
@mat H pine 5
@mat I dwood 1
@layer horse
@mblock 0 0
