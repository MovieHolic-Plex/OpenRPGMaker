@cell 16
@palette palette.pal
@mat R red 3
@mat H red 4
@mat L red 5
@mat D red 1
@mat B blue 3
@mat C blue 4
@mat b blue 1
@mat Y yellow 3
@mat J yellow 4
@mat y yellow 1
@mat G green 3
@mat F green 4
@mat g green 1
@mat P purple 3
@mat Q purple 4
@mat p purple 1
@mat e linen 5
@mat f linen 4
@mat s linen 3
@layer books
@mblock 0 0
