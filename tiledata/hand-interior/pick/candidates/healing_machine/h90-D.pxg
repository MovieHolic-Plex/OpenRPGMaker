= 1s 1w 1H 1b 5h 1d 1H 8t 1g 1d 4h 1b 1g 1b 1m 1o
= 1s 1w 1H 1b 5h 1d 10g 1d 4h 1b 1g 1b 1m 1o
= 1s 1w 1H 1b 21h 1b 1g 1b 1m 1o
= 1s 1w 1H 1G 3h 1G 1H 12h 1G 1g 2h 1G 1g 1b 1m 1o
