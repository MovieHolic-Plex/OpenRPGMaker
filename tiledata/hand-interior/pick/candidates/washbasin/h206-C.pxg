// 왼쪽 대야 테에서 늘어진 수건 복원(x=1~3, y=11~23)
@px 1 11 white:6 2 11 white:5 3 11 white:5
@px 1 12 linen:5 2 12 linen:5 3 12 linen:4
@px 1 13 linen:5 2 13 linen:5 3 13 linen:4
@px 1 14 linen:5 2 14 linen:5 3 14 linen:4
@px 1 15 blue:3 2 15 blue:3 3 15 blue:2
@px 1 16 blue:3 2 16 blue:3 3 16 blue:2
@px 1 17 linen:5 2 17 linen:5 3 17 linen:4
@px 1 18 linen:5 2 18 linen:5 3 18 linen:4
@px 1 19 blue:3 2 19 blue:3 3 19 blue:2
@px 1 20 blue:3 2 20 blue:3 3 20 blue:2
@px 1 21 linen:5 2 21 linen:5 3 21 linen:4
@px 1 22 linen:5 2 22 linen:4 3 22 linen:4
@px 1 23 linen:4 3 23 linen:3
