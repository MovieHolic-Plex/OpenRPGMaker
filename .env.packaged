# 패키징 빌드(`vite build --mode packaged`)용 덮어쓰기다.
# .env.[mode] 는 .env.local 보다 우선하므로 여기서 비운 값이 번들에 빈 문자열로 박힌다.
#
# 왜 Supabase 키까지 비우나 (2026-09-22 실측): `src/assets/bgmCdn.ts` 의 ambientEnv() 가
# `import.meta.env` 를 **통째로** 참조해 Vite 가 env 객체 전체를 번들에 직렬화했다. 그래서
# .env.local 에만 있고 여기 없는 VITE_* 는 무엇이든 출하물에 그대로 박혔다 — 실측으로 패키징
# AppImage 안에 `VITE_SUPABASE_URL:"http://dbserver:8100"` 과 anon JWT 가 들어갔다.
# 근본 원인(통째 참조)은 bgmCdn.ts 에서 키 하나만 읽도록 고쳤고, 이 목록은 마지막 방어선이다.
# 새 VITE_* 를 .env.local 에 추가하면 여기에도 빈 값으로 나열하라.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_USE_PROXY=
VITE_LLM_API_URL=
VITE_LLM_API_KEY=
VITE_YUNWU_API_KEY=
VITE_OPENROUTER_BASE_URL=
VITE_OPENROUTER_MODEL=
