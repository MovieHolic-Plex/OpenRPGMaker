        {
          "actorId": "actor_fs_elena",
          "level": 9
        },
        {
          "actorId": "actor_fs_iris",
          "level": 9
        }
      ],
      "beats": [
        {
          "id": "siege",
          "note": "포위 장면이 레터박스를 켠다(수정 전후 같다)",
          "ops": [
            {
              "kind": "waitFor",
              "testid": "cutscene-skip-hint",
              "state": "present",
              "timeoutMs": 60000
            },
            {
              "kind": "hold",
              "dir": null,
              "ms": 1500
