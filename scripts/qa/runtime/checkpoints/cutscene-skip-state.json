      "beats": [
        {
          "id": "skip",
          "ops": [
            {
              "kind": "waitFor",
              "testid": "cutscene-skip-hint",
              "state": "present",
              "timeoutMs": 60000
            },
            {
              "kind": "hold",
              "dir": null,
              "ms": 1500
            },
            {
              "kind": "keyBurst",
              "keys": [
                "Escape",
                "Escape"
              ],
              "intervalMs": 110
            },
            {
              "kind": "waitFor",
              "testid": "cutscene-skip-hint",
              "state": "absent",
              "timeoutMs": 30000
