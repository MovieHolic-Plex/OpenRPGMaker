        {
          "id": "ending",
          "note": "Esc 두 번 → 엔딩 화면까지",
          "ops": [
            {
              "kind": "keyBurst",
              "keys": [
                "Escape",
                "Escape"
              ],
              "intervalMs": 110
            },
            {
              "kind": "repeatUntil",
              "testid": "ending-screen",
              "state": "present",
              "maxRounds": 140,
              "ops": [
                {
                  "kind": "key",
                  "key": "Enter"
                },
                {
                  "kind": "hold",
                  "dir": null,
                  "ms": 500
                }
              ]
            },
            {
              "kind": "hold",
              "dir": null,
              "ms": 2500
            }
          ],
          "expect": {
            "testidPresent": [
              "ending-screen"
            ]
          },
          "shot": true
        },
        {
          "id": "act2-arrival",
          "note": "엔딩 → 「제2막으로」 → 감방. 화면 위아래 검은 띠가 없어야 한다",
          "ops": [
            {
              "kind": "key",
              "key": "Enter",
              "times": 2,
              "holdMs": 80
            },
            {
              "kind": "hold",
              "dir": null,
              "ms": 4000
            },
            {
              "kind": "repeatUntil",
              "testid": "ending-screen",
              "state": "absent",
              "maxRounds": 40,
              "ops": [
                {
                  "kind": "key",
                  "key": "Enter"
                },
                {
                  "kind": "hold",
                  "dir": null,
                  "ms": 900
                }
              ]
            },
            {
              "kind": "waitForMap",
              "mapId": "fs2_cell",
              "timeoutMs": 60000
            },
            {
              "kind": "hold",
              "dir": null,
              "ms": 2500
            }
          ],
          "expect": {
            "mapId": "fs2_cell",
            "pageAssertions": [
              {
                "id": "no-letterbox",
                "fn": "() => { const b = document.querySelector(\"[data-testid='runtime-letterbox-top']\"); const h = b ? Math.round(b.getBoundingClientRect().height) : 0; return h === 0 || ('letterbox ' + h + 'px'); }"
              }
            ]
