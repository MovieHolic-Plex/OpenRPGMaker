{"set": "rt-shitamachi-ending-card", "projectGenerator": {"game": "shitamachi-fourth-season"}, "viewport": {"width": 960, "height": 540}, "checkpoints": [{"id": "anchor", "label": "옥상 도착(유나와 걷기, 마음 5)", "note": "2026-10-25 재구성 판 브라우저 플레이(tmp/qp/a7 saves/0425) — 등롱 길을 유나와 걷기로 고른 뒤 옥상 입구 (17,22). 자동 고백 장면이 곧 시작된다.", "snapshot": {"schemaVersion": 5, "projectTitle": "시타마치의 네 번째 계절", "savedAt": "2026-10-25T07:39:04.167Z", "mapName": "히카리 맨션 옥상", "partyLevel": 1, "playTimeSeconds": 1546, "sceneLine": "등롱지기 아저씨: 히카리 맨션 옥상에 올라가 봐. 아케이드 등롱이 한눈에 보이…", "session": {"switches": {"sw_0001": false, "sw_0002": false, "sw_0003": false, "sw_0004": false, "sw_0005": false, "sw_0006": false, "sw_0007": false, "sw_0008": false, "sw_0009": false, "sw_0010": false, "sw_0011": false, "sw_0012": false, "sw_0013": false, "sw_0014": false, "sw_0015": false, "sw_0016": false, "sw_0017": false, "sw_0018": false, "sw_0019": false, "sw_0020": false, "sw_gen2_sun_relay": false, "sw_gen2_moon_relay": false, "sw_gen2_bridge_relay": false, "sw_gen2_seal_relay": false, "sw_catalog_gate_open": false, "sw_catalog_lighthouse_lit": false, "sw_catalog_mine_lift": false, "sw_catalog_fountain_flow": false, "sw_catalog_archive_unlock": false, "sw_catalog_beacon_lit": false, "sw_catalog_aqueduct_route": false, "switch_shared_relay_sun": false, "switch_shared_relay_moon": false, "switch_shared_relay_tide": false, "switch_shared_relay_earth": false, "sw_sm_lantern_seoyeon": true, "sw_sm_lantern_jiho": true, "sw_sm_lantern_yuna": true, "sw_shitamachi_lantern_lit": true, "sw_sm_photo_seen": true, "sw_sm_note_read": true, "sw_sm_gather": true, "sw_sm_jiho_taste": true, "sw_sm_train_yuna_off": true, "sw_sm_seoyeon_hub_off": true}, "selfSwitches": {}, "variables": {"var_0001": 0, "var_0002": 0, "var_0003": 0, "var_0004": 0, "var_0005": 0, "var_0006": 0, "var_0007": 0, "var_0008": 0, "var_0009": 0, "var_0010": 0, "var_0011": 0, "var_0012": 0, "var_0013": 0, "var_0014": 0, "var_0015": 0, "var_0016": 0, "var_0017": 0, "var_0018": 0, "var_0019": 0, "var_0020": 0, "var_sm_stage": 3, "var_sm_date": 3, "var_sm_lanterns": 3, "var_sm_seoyeon": 0, "var_sm_jiho": 2, "var_sm_yuna": 5}, "timers": {}, "gold": 0, "inventory": {}, "itemUseCharges": {}, "killedFieldSpawns": {}, "partyActorIds": ["actor_hero"], "shippingQueue": {}, "shippingHistory": [], "bundleContributions": {}, "completedBundleIds": [], "bundleRewardAppliedIds": [], "unlockedRegionIds": [], "unlockedRecipeIds": [], "makerInstances": {}, "monsterInstances": {}, "monsterParty": [], "monsterBox": [], "actorSkillIds": {}, "actorSkillPp": {}, "actorExperience": {"actor_hero": 0}, "actorLevels": {"actor_hero": 1, "actor_guardian": 1, "actor_mage": 1, "actor_scout": 1, "actor_cleric": 1, "actor_ranger": 1, "actor_samurai": 1, "actor_ninja": 1, "actor_monk": 1, "actor_bard": 1, "actor_druid": 1, "actor_witch": 1, "actor_valkyrie": 1, "actor_paladin": 1, "actor_red_mage": 1, "actor_dark_knight": 1, "actor_chronomancer": 1, "actor_thief": 1, "actor_beast_tamer": 1, "actor_pirate": 1, "actor_sorceress": 1, "actor_elf_archer": 1, "actor_hunter": 1, "actor_brawler": 1, "actor_martial_artist": 1, "actor_general": 1, "actor_prince": 1, "actor_berserker": 1, "actor_gunner": 1, "actor_dancer": 1, "actor_alchemist": 1, "actor_summoner": 1, "actor_squire": 1, "actor_flower_girl": 1, "actor_swordsman": 1, "actor_scholar": 1, "actor_miner": 1, "actor_farmer": 1, "actor_elder": 1, "actor_grandma": 1, "actor_gunslinger": 1, "actor_butler": 1, "actor_priest_monk": 1, "actor_gypsy": 1, "actor_sword_dancer": 1, "actor_gambler": 1, "actor_seraph": 1, "actor_fairy": 1, "actor_king": 1, "actor_merchant": 1, "actor_noble": 1, "actor_princess": 1, "actor_archmage": 1, "actor_heavy_knight": 1, "actor_mercenary": 1, "actor_dragoon": 1, "actor_villager": 1, "actor_tribal": 1, "actor_fortune_teller": 1, "actor_sailor": 1, "actor_monk_elder": 1, "actor_noblewoman": 1, "actor_nomad": 1, "actor_nun": 1, "actor_jester": 1, "actor_girl_alchemist": 1, "actor_ronin": 1, "actor_shrine_maiden": 1, "actor_desert_warrior": 1, "actor_maid": 1, "actor_hermit": 1, "actor_old_warrior": 1, "actor_dog": 1, "actor_cat": 1, "actor_rooster": 1, "actor_sheep": 1, "actor_cow": 1, "actor_horse": 1, "actor_tiger": 1, "actor_lion": 1, "actor_skiff": 1, "actor_galleon": 1, "actor_gunboat": 1, "actor_balloon": 1, "actor_drill": 1, "actor_tank": 1, "actor_airship": 1, "actor_ufo": 1, "actor_slime_pal": 1, "actor_demon": 1, "actor_ogre_kid": 1, "actor_ghost_pal": 1, "actor_skeleton_pal": 1, "actor_zombie_pal": 1, "actor_reaper": 1, "actor_minotaur_pal": 1, "actor_harpy_pal": 1, "actor_gargoyle_pal": 1, "actor_vampire": 1, "actor_demon_knight": 1, "actor_golem_pal": 1, "actor_dragonewt": 1, "actor_oni_warrior": 1, "actor_dark_lord": 1, "actor_siren": 1, "actor_lamia": 1, "actor_wraith_mage": 1, "actor_succubus": 1, "actor_mound": 1, "actor_red_dragon_pal": 1, "actor_flame_spirit": 1, "actor_demon_general": 1, "actor_treant": 1, "actor_mushroom": 1, "actor_kappa": 1, "actor_kitsune": 1, "actor_tanuki": 1, "actor_golem_moss": 1, "actor_sprite_ice": 1, "actor_mandrake": 1, "actor_mimic_pal": 1, "actor_living_armor": 1, "actor_lantern_ghost": 1, "actor_doll": 1, "actor_book_demon": 1, "actor_scarecrow": 1, "actor_clockwork": 1, "actor_candle_imp": 1, "actor_yeti": 1, "actor_merfolk": 1, "actor_cyclops": 1, "actor_mothman": 1, "actor_basilisk": 1, "actor_djinn": 1, "actor_chimera": 1, "actor_dark_angel": 1}, "actorVitals": {"actor_hero": {"hp": 514, "mp": 43, "maxHp": 514, "maxMp": 43}}, "eventLocations": {}, "erasedEventIds": [], "occupiedLocationIds": {"map_venue_train": [], "map_shitamachi_arcade": [], "map_venue_house": [], "map_venue_bakery": [], "map_venue_rooftop": ["loc3"], "map_venue_sento": [], "map_venue_council": []}, "removedEventIds": {}, "spawnedEvents": {}, "camera": {"mode": "follow", "target": {"kind": "player"}}, "lighting": {"ambient": 0.55, "color": "#121734", "sources": [{"id": "roof_glow_a", "at": {"x": 17, "y": 16}, "radius": 5, "intensity": 0.9, "color": "#ffbf73"}, {"id": "roof_glow_b", "at": {"x": 17, "y": 22}, "radius": 3, "intensity": 0.7, "color": "#ffd9a0"}, {"id": "roof_street_3", "at": {"x": 3, "y": 22}, "radius": 2.4, "intensity": 0.75, "color": "#ff9f4a", "flicker": true}, {"id": "roof_street_7", "at": {"x": 7, "y": 22}, "radius": 2.4, "intensity": 0.75, "color": "#ff9f4a", "flicker": true}, {"id": "roof_street_11", "at": {"x": 11, "y": 22}, "radius": 2.4, "intensity": 0.75, "color": "#ff9f4a", "flicker": true}, {"id": "roof_street_15", "at": {"x": 15, "y": 22}, "radius": 2.4, "intensity": 0.75, "color": "#ff9f4a", "flicker": true}, {"id": "roof_street_19", "at": {"x": 19, "y": 22}, "radius": 2.4, "intensity": 0.75, "color": "#ff9f4a", "flicker": true}, {"id": "roof_street_23", "at": {"x": 23, "y": 22}, "radius": 2.4, "intensity": 0.75, "color": "#ff9f4a", "flicker": true}, {"id": "roof_street_27", "at": {"x": 27, "y": 22}, "radius": 2.4, "intensity": 0.75, "color": "#ff9f4a", "flicker": true}, {"id": "roof_street_31", "at": {"x": 31, "y": 22}, "radius": 2.4, "intensity": 0.75, "color": "#ff9f4a", "flicker": true}]}, "npcTravelStates": {}, "npcActivities": {}, "npcScheduleStates": {}, "lifeSkills": {}, "farmPlots": {}, "friendship": {"yuna": 500, "jiho": 200}, "relationships": {}, "dialogueBacklog": [{"kind": "line", "text": "가을의 끝, 저녁 통학 전철.", "context": "narration"}, {"kind": "line", "text": "여덟 살 때 떠났던 시타마치로 돌아온 게 올봄이었다.", "speaker": "하진", "context": "thought"}, {"kind": "line", "text": "봄, 여름, 가을. 이 동네에서 맞는 세 번째 계절도 다 지나간다.", "speaker": "하진", "context": "thought"}, {"kind": "line", "text": "…저 애, 오늘도 같은 칸이네.", "speaker": "하진", "context": "thought"}, {"kind": "line", "text": "…….", "speaker": "유나", "context": "speech"}, {"kind": "line", "text": "(낡은 필름 카메라를 두 손으로 감싸 쥐고 창밖을 보고 있다.)", "speaker": "유나", "context": "speech"}, {"kind": "choice", "picked": "카메라에 대해 묻는다"}, {"kind": "line", "text": "그거, 필름 카메라지? 요즘 보기 드문데.", "speaker": "하진", "context": "speech"}, {"kind": "line", "text": "아… 네. 할머니 거예요.", "speaker": "유나", "context": "speech"}, {"kind": "line", "text": "내일 상점가 등롱 축제를 찍고 싶어서요. 불이 켜지는 순간이 제일 예쁘거든요.", "speaker": "유나", "context": "speech"}, {"kind": "line", "text": "곧 시타마치, 시타마치입니다. 내리실 문은 왼쪽입니다.", "speaker": "안내 방송", "context": "speech"}, {"kind": "line", "text": "…저, 여기서 내려요. 그럼.", "speaker": "유나", "context": "speech"}, {"kind": "line", "text": "시타마치 상점가. 아케이드 지붕 아래로 저녁 장 보는 사람들이 오간다.", "context": "narration"}, {"kind": "line", "text": "하진! 딱 맞춰 왔네.", "speaker": "서연", "context": "speech"}, {"kind": "line", "text": "서연? 학생회장이 여기서 뭐 해?", "speaker": "하진", "context": "speech"}, {"kind": "line", "text": "내일 밤이 「시타마치 등롱 축제」인 거 알지? 진흥회 어르신들 일손이 모자라서 학생회가 돕기로 했어.", "speaker": "서연", "context": "speech"}, {"kind": "line", "text": "정문 큰 등롱에 「소원 등롱」 세 개를 넣어야 불이 켜지는데, 아직 하나도 안 모였어.", "speaker": "서연", "context": "speech"}, {"kind": "line", "text": "하나는 코하루 베이커리, 하나는 센토 마츠노유. 마지막 하나는… 진흥회 사무소에서 서류랑 씨름 중인 나한테 있고.", "speaker": "서연", "context": "speech"}, {"kind": "line", "text": "셋 다 모이면 정문 옆 등롱지기 아저씨한테 가져다드리면 돼.", "speaker": "서연", "context": "speech"}, {"kind": "choice", "picked": "「학생회 일을 왜 내가…」"}, {"kind": "line", "text": "…그러게. 미안, 부탁할 사람이 너밖에 생각이 안 났어.", "speaker": "서연", "context": "speech"}, {"kind": "line", "text": "베이커리는 지호네잖아. 네 소꿉친구. 센토는 아케이드 지나 북쪽 뒷길이고. 그럼, 사무소에서 기다릴게!", "speaker": "서연", "context": "speech"}, {"kind": "line", "text": "소원 등롱 세 개. 베이커리, 센토, 진흥회 사무소.", "speaker": "하진", "context": "thought"}, {"kind": "line", "text": "…그 전에 집에 들러 가방부터 놓고 갈까. 우리 집은 아케이드 지나 북쪽 뒷길이다.", "speaker": "하진", "context": "thought"}, {"kind": "line", "text": "식탁 위에 엄마의 쪽지가 있다.", "context": "narration"}, {"kind": "line", "text": "하진아, 진흥회 일 돕는다며? 내일 축제 끝나고 늦으면 연락해. 저녁은 냉장고에.", "speaker": "엄마의 쪽지", "context": "speech"}, {"kind": "line", "text": "추신. 지호네 빵집에 안부 전해 줘. 너 어릴 때 거기서 살다시피 했잖니.", "speaker": "엄마의 쪽지", "context": "speech"}, {"kind": "line", "text": "책장 위에 낡은 사진 한 장.", "context": "narration"}, {"kind": "line", "text": "코하루 베이커리 앞. 등롱을 든 채 울고 있는 꼬마 지호와, 그 옆에서 어쩔 줄 모르는 나.", "speaker": "하진", "context": "thought"}, {"kind": "line", "text": "…이사 가던 날이다. 내년엔 같이 등롱 보자고, 그렇게 말했었지.", "speaker": "하진", "context": "thought"}, {"kind": "line", "text": "어서 오세요~ …어? 하진이잖아!", "speaker": "지호", "context": "speech"}, {"kind": "line", "text": "등롱 받으러 왔지? 서연이한테 들었어. 근데 잠깐만, 내일 팔 등롱빵 반죽이 아직 반이나 남았거든.", "speaker": "지호", "context": "speech"}, {"kind": "line", "text": "어릴 때 너, 우리 가게 반죽 몰래 뜯어 먹다가 할머니한테 혼났던 거 기억나?", "speaker": "지호", "context": "speech"}, {"kind": "choice", "picked": "「바쁘면 등롱만 받아 갈게.」"}, {"kind": "line", "text": "…응. 그렇지. 바쁘지, 다들.", "speaker": "지호", "context": "speech"}, {"kind": "line", "text": "집에서 옛날 사진 봤어. 이 가게 앞에서 찍은 거. 너 그때 등롱 들고 울고 있더라.", "speaker": "하진", "context": "speech"}, {"kind": "line", "text": "으아, 그 사진! …그날 너 이사 가는 날이었잖아. 내년 등롱은 같이 보자고, 네가 약속했어.", "speaker": "지호", "context": "speech"}, {"kind": "line", "text": "아, 엄마가 안부 전해 달래. 내가 어릴 때 여기서 살다시피 했다고.", "speaker": "하진", "context": "speech"}, {"kind": "line", "text": "아줌마가? 헤헤. 우리 할머니도 네 얘기 자주 해. 그 반죽 도둑은 잘 크고 있냐고.", "speaker": "지호", "context": "speech"}, {"kind": "line", "text": "자, 코하루 베이커리 소원 등롱. 안에 뭐 적었는지는 보지 마!", "speaker": "지호", "context": "speech"}, {"kind": "line", "text": "소원 등롱을 받았다.", "context": "narration"}, {"kind": "line", "text": "잠깐! 내일 팔 등롱빵 첫 판이 나왔어. 시식해 줘. 솔직하게!", "speaker": "지호", "context": "speech"}, {"kind": "line", "text": "주황색 등롱 모양 빵. 겉은 바삭하고, 안에는 따뜻한 커스터드.", "context": "narration"}, {"kind": "choice", "picked": "「맛있다. 근데 조금 달아.」"}, {"kind": "line", "text": "흐음, 설탕 조금 줄여 볼게. 역시 넌 솔직하다니까.", "speaker": "지호", "context": "speech"}, {"kind": "line", "text": "어서 오세… 아. 전철의…", "speaker": "유나", "context": "speech"}, {"kind": "line", "text": "여기가 너네 집이었어?", "speaker": "하진", "context": "speech"}, {"kind": "line", "text": "할머니 센토예요. 저는 번대(접수대)를 봐요. …등롱, 받으러 오셨죠.", "speaker": "유나", "context": "speech"}, {"kind": "line", "text": "이 사진, 십 년 전 등롱 축제예요. 할머니가 찍었어요. 저는 이 불빛을 다시 찍고 싶어서 카메라를 들었어요.", "speaker": "유나", "context": "speech"}, {"kind": "choice", "picked": "「내일 네 사진, 나도 보고 싶어.」"}, {"kind": "line", "text": "…현상하면, 제일 먼저 보여 드릴게요.", "speaker": "유나", "context": "speech"}, {"kind": "line", "text": "마츠노유의 소원 등롱이에요. 조심히… 들고 가세요.", "speaker": "유나", "context": "speech"}, {"kind": "line", "text": "소원 등롱을 받았다.", "context": "narration"}, {"kind": "line", "text": "왔어? …미안, 서류가 산더미라. 축제 순서표에 가게 마흔 곳 등롱 위치에, 안전 점검표까지.", "speaker": "서연", "context": "speech"}, {"kind": "line", "text": "학생회장이 이런 것도 못 하면 안 되잖아. 그러니까 괜찮아.", "speaker": "서연", "context": "speech"}, {"kind": "choice", "picked": "「회장이니까 잘하겠지. 등롱만 줘.」"}, {"kind": "line", "text": "…응. 그래야지.", "speaker": "서연", "context": "speech"}, {"kind": "line", "text": "진흥회 몫 소원 등롱이야. …내 소원도 들어 있어. 읽지 마.", "speaker": "서연", "context": "speech"}, {"kind": "line", "text": "소원 등롱을 받았다.", "context": "narration"}, {"kind": "line", "text": "내일 등롱 축제지? 우리 가게도 등롱 달았어.", "speaker": "장 보는 아주머니", "context": "speech"}, {"kind": "line", "text": "네가 서연이가 말한 그 친구구나.", "speaker": "등롱지기 아저씨", "context": "speech"}, {"kind": "line", "text": "오, 세 개 다 모였네! 서연이 말대로 든든한데.", "speaker": "등롱지기 아저씨", "context": "speech"}, {"kind": "line", "text": "자, 정문 큰 등롱에 넣어 봐. 이 등롱은 해마다 동네 아이들 소원으로 불을 켜 왔어.", "speaker": "등롱지기 아저씨", "context": "speech"}, {"kind": "line", "text": "하진, 다 모았구나! 지호랑 유나도 불렀어. 점등은 다 같이 봐야지.", "speaker": "서연", "context": "speech"}, {"kind": "line", "text": "우리 빵집 등롱도 들어갔지? 내 소원은 비밀!", "speaker": "지호", "context": "speech"}, {"kind": "line", "text": "…카메라, 준비됐어요.", "speaker": "유나", "context": "speech"}, {"kind": "line", "text": "아케이드 지붕 아래, 등롱이 하나씩 켜진다.", "context": "narration"}, {"kind": "line", "text": "……예쁘다.", "speaker": "유나", "context": "speech"}, {"kind": "line", "text": "와아… 어릴 때 본 거랑 똑같아!", "speaker": "지호", "context": "speech"}, {"kind": "line", "text": "해냈네, 우리.", "speaker": "서연", "context": "speech"}, {"kind": "line", "text": "등롱 길은 둘이 걸어야 제맛이지. 누구랑 걸을 거야?", "speaker": "등롱지기 아저씨", "context": "speech"}, {"kind": "choice", "picked": "유나와 걷는다"}, {"kind": "line", "text": "히카리 맨션 옥상에 올라가 봐. 아케이드 등롱이 한눈에 보이는 자리야.", "speaker": "등롱지기 아저씨", "context": "speech"}], "dialogueRead": ["16uyucj", "df4tb4", "1ko5tzm", "f8gijm", "nfel3f", "1cedjz8", "hp4kcw", "4vsucl", "bt0xtk", "1gmz0vn", "1ahytml", "1ywrdrn", "9ahqyv", "c0fua0", "qa9skq", "5h81e1", "1su2g5p", "i6t8bd", "dibile", "1ne4wta", "1h12bmg", "67wy3e", "vcw15q", "m05tpp", "idi06q", "198sks3", "grroc3", "wqla8h", "ynqbgt", "1b0ftuo", "mpa39e", "wf9lbz", "1svrmg8", "lnk2hr", "2nyorz", "sjjq6s", "6frqul", "1vudc82", "1ye5w0b", "7mu1pe", "18feszs", "mjylhp", "5g4qjp", "1lb21ry", "4yodw0", "158c4d6", "9mi3yr", "zb9dnm", "bkl8wc", "ji9q6a", "a1ilsq", "4whc6u", "147pi37", "lvdrsm", "1ce6opg", "189jgid", "7v00w7", "p0tmoz", "13hkzb7", "d5iw9p", "f8dybh", "18atcm5", "8ybyqi", "47fn9b"], "dailyGifts": {}, "dailyTalks": {}, "monsterCareSteps": 1, "monsterCareDaily": {"no-time": 0}, "chests": {}, "placeables": {}, "followers": [], "followerTrail": [], "currentMapId": "map_venue_rooftop", "x": 17, "y": 22, "mapOverrides": {}, "flags": {"screen-effect:fadeIn": true, "screen-effect:fadeOut": true}, "audio": {"bgm": {"resourceId": "cc0-bgm-rtp-mys-002", "loop": true, "fadeInMs": 1500}, "se": {"resourceId": "cc0-se-osx-bell-01", "loop": false}}, "pictures": {}, "actorEquipment": {"actor_hero": {"weapon": "equip_sword", "shield": "equip_oak_shield", "armor": "equip_leather_armor", "helmet": "equip_traveler_hat", "accessory": "equip_focus_charm"}, "actor_guardian": {"weapon": "equip_sword", "shield": "equip_oak_shield", "armor": "equip_leather_armor", "helmet": "equip_traveler_hat", "accessory": "equip_focus_charm"}, "actor_mage": {"weapon": "equip_mage_staff", "armor": "equip_mystic_robe", "helmet": "equip_traveler_hat", "accessory": "equip_focus_charm"}, "actor_scout": {"weapon": "equip_scout_dagger", "armor": "equip_leather_armor", "helmet": "equip_traveler_hat", "accessory": "equip_focus_charm"}, "actor_cleric": {"weapon": "equip_mage_staff", "shield": "equip_oak_shield", "armor": "equip_mystic_robe", "helmet": "equip