assert.equal(normalizeSunlight().enabled,false);assert.equal(normalizeSunlight().altitude,65);assert.equal(patchSunlight({enabled:true,altitude:35},{enabled:false}).altitude,35);checks.push('short shadow default stays off and preserves explicitly authored low sun');
fs.mkdirSync('verify-shots/gabled-roof',{recursive:true});fs.writeFileSync('verify-shots/gabled-roof/contracts.json',JSON.stringify({checks,projectWrites:false},null,2));console.log({checks});
