// Focused production-tool checks and a saved SQLite fixture for a real assistant edit.
import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { runTool } from '../../src/editor/tools';
import { buildSessionRegistryTools } from '../../src/ai/sessionToolExposure';
import { initLocalProjectStore, openLocalProjectStore } from '../../electron/local-store/store';
import { layerTileAt } from '../../src/project/mapLayers';
import { assertHouseProtection, captureHouseProtection } from '../../src/editor/tools/houseProtection';
import type { Project } from '../../src/project/types';
const arg=(n:string,f:string)=>{const i=process.argv.indexOf(`--${n}`);return i<0?f:process.argv[i+1]!;};
const source=path.resolve(arg('source','.vite-cache/terrain-body-rims/source/project.json'));
const folder=path.resolve(arg('project','.vite-cache/terrain-ai-edit/project'));
const out=path.resolve(arg('out','verify-shots/terrain-ai-edit/contracts'));
fs.mkdirSync(out,{recursive:true});
const p=JSON.parse(fs.readFileSync(source,'utf8')) as Project;
const ctx={project:p,currentMapId:'houses_native'};
const checks:string[]=[],calls:unknown[]=[];
function run(name:string,args:Record<string,unknown>,ok=true){const r=runTool(ctx,name,args);calls.push({name,args,ok:r.ok,summary:r.summary,issues:r.issues});assert.equal(r.ok,ok,`${name}: ${r.summary} ${JSON.stringify(r.issues)}`);return r.data as any;}
const map=()=>ctx.project.maps.houses_native!;
const sameMap=(before:string)=>assert.equal(JSON.stringify(map()),before);
let m=map();m.terrainDesign??={};m.terrainDesign.lockedCells=[0];
let before=JSON.stringify(m);
run('sculpt_relief',{mapId:m.id,ops:[{op:'rect',rect:[0,0,0,0],h:10}]},false);sameMap(before);checks.push('locked height edit rejected atomically');
const initial=run('inspect_terrain',{mapId:m.id}),native=initial.houses[0];
run('sculpt_relief',{mapId:m.id,ops:[{op:'rect',rect:[native.x,native.y,native.x,native.y],h:14}]},false);sameMap(before);checks.push('partial house foundation edit rejected atomically');
// Whole-foundation elevation is supported; it is not a blanket ban on existing houses.
const savedProject=ctx.project;
run('sculpt_relief',{mapId:m.id,ops:[{op:'rect',rect:[native.x,native.y,native.x+native.width-1,native.y+native.height-1],h:5},
 {op:'rect',rect:[native.doorFront.x,native.doorFront.y,native.doorFront.x,native.doorFront.y],h:5}]});
assert.equal(run('inspect_terrain',{mapId:m.id}).houses[0].flat,true);ctx.project=savedProject;checks.push('whole foundation and door front can move together');
run('design_terrain',{mapId:m.id,tool:'contour',points:[{x:5,y:12},{x:21,y:25}],areaShape:'rect',delta:1});
assert.equal(run('inspect_terrain',{mapId:m.id}).houses[0].flat,true);
for(let y=native.y;y<native.y+native.height;y++)for(let x=native.x;x<native.x+native.width;x++)assert.equal(map().relief!.levels[y*m.width+x],4);
ctx.project=savedProject;checks.push('terrain design protects the complete native footprint');
const ridge=run('design_terrain',{mapId:m.id,tool:'ridge',points:[{x:2,y:38},{x:8,y:38}],width:5,delta:3,seed:42});
const fixtureBeforeEdit=ctx.project;
run('design_terrain',{mapId:m.id,editId:ridge.featureId,width:7});
let f=map().terrainDesign!.features!.find(f=>f.id===ridge.featureId)!;
assert.equal(f.options.delta,3);assert.equal(f.options.seed,42);assert.equal(f.options.width,7);assert.deepEqual(f.points,[{x:2,y:38},{x:8,y:38}]);
assert.equal(map().terrainDesign!.features!.filter(f=>f.id===ridge.featureId).length,1);checks.push('partial feature edit retains points, delta, seed and ID');
before=JSON.stringify(map());run('design_terrain',{mapId:m.id,editId:'missing',width:9},false);sameMap(before);checks.push('missing feature rejects without mutation');
ctx.project=fixtureBeforeEdit;
const added=run('place_terrain_house',{mapId:m.id,anchor:{x:24,y:46},style:'beodeul-manor-a',width:9,stories:2,roofWidth:11});
const roofBase=ctx.project;
const house=run('inspect_terrain',{mapId:m.id}).houses.find((h:any)=>h.placementId===added.placementId);
const walls=house.parts.find((part:any)=>part.id==='walls');
const wallPixels=[];
for(let y=walls.y;y<walls.y+walls.height;y++)for(let x=walls.x;x<walls.x+walls.width;x++)wallPixels.push([x,y,layerTileAt(map(),1,y*m.width+x),layerTileAt(map(),3,y*m.width+x)]);
run('resize_terrain_house_roof',{mapId:m.id,placementId:added.placementId,roofWidth:15});
const grown=run('inspect_terrain',{mapId:m.id}).houses.find((h:any)=>h.placementId===added.placementId);
assert.deepEqual(grown.parts.find((part:any)=>part.id==='walls'),walls);assert.deepEqual(grown.doorFront,house.doorFront);
assert.equal(grown.parts.find((part:any)=>part.id==='roof').width,15);
for(const [x,y,l,u]of wallPixels){assert.equal(layerTileAt(map(),1,y!*m.width+x!),l);assert.equal(layerTileAt(map(),3,y!*m.width+x!),u);}
assert.equal(map().structurePlacements!.length,4);checks.push('roof-only resize preserves every wall tile, door, floor and placement ID');
const accepted=captureHouseProtection(roofBase),grownProject=ctx.project;
assertHouseProtection(accepted,JSON.parse(JSON.stringify(grownProject)),[]);checks.push('roof resize also passes final application after serialization');
const wallCorrupt=JSON.parse(JSON.stringify(grownProject)),wallIndex=walls.y*m.width+walls.x;
wallCorrupt.maps[m.id].lowerTiles[wallIndex]=wallCorrupt.maps[m.id].lowerTiles[wallIndex]===737?-1:737;
assert.throws(()=>assertHouseProtection(accepted,wallCorrupt,[]));checks.push('roof edit cannot bypass wall protection');
const overlayCorrupt=JSON.parse(JSON.stringify(grownProject));overlayCorrupt.maps[m.id].lowerOverlayTiles??=Array(m.width*m.height).fill(-1);
overlayCorrupt.maps[m.id].lowerOverlayTiles[native.y*m.width+native.x]=737;
assert.throws(()=>assertHouseProtection(accepted,overlayCorrupt,[]));checks.push('second-layer overpainting of other houses is rejected');
const humanEdited=JSON.parse(JSON.stringify(roofBase));humanEdited.maps[m.id].lowerOverlayTiles??=Array(m.width*m.height).fill(-1);
humanEdited.maps[m.id].lowerOverlayTiles[walls.y*m.width+walls.x]=737;
assert.throws(()=>assertHouseProtection(captureHouseProtection(humanEdited),grownProject,[]));checks.push('later human overlay edit cannot be overwritten by a stale roof proposal');
run('resize_terrain_house_roof',{mapId:m.id,placementId:added.placementId,roofWidth:9});
assertHouseProtection(captureHouseProtection(grownProject),ctx.project,[]);checks.push('shrinking restores the former roof fringe');
before=JSON.stringify(map());run('resize_terrain_house_roof',{mapId:m.id,placementId:native.placementId,roofWidth:17},false);sameMap(before);checks.push('fixed native roof cannot be silently replaced');
ctx.project=roofBase;
const road=run('lay_terrain_road',{mapId:m.id,points:[{x:24,y:54},{x:24,y:47}],width:2});
const baseline=ctx.project;
run('lay_terrain_road',{mapId:m.id,editId:road.featureId,width:3});
f=map().terrainDesign!.features!.find(f=>f.id===road.featureId)!;assert.equal(f.options.flattenRoad,false);assert.equal(f.options.width,3);assert.equal(f.points.length,2);
assert.equal(run('check_terrain_access',{mapId:m.id,from:{x:4,y:58},targets:run('inspect_terrain',{mapId:m.id}).houses.map((h:any)=>h.doorFront)}).reachable,true);
checks.push('road reedit preserves points and all four actual entrances remain reachable');
ctx.project=baseline;
const intent={mode:'modify',source:'llm',tools:['get_map_region'],space:'none',targetMapId:m.id} as any;
const exposed=buildSessionRegistryTools({requestText:'절벽과 경사로를 다듬고 기존 집 지붕만 넓혀 줘',intent,contextWindow:200000}).map(t=>t.function.name);
for(const name of ['inspect_terrain','sculpt_relief','design_terrain','lay_terrain_road','resize_terrain_house_roof','check_terrain_access','show_map_region'])assert(exposed.includes(name),name);
checks.push('natural language exposes the complete terrain edit and verification tools');
assert.equal(JSON.stringify(ctx.project.maps.ramps_four),JSON.stringify(p.maps.ramps_four));
assert.equal(JSON.stringify(ctx.project.maps.terrain_ai),JSON.stringify(p.maps.terrain_ai));checks.push('unrelated maps remain byte-for-byte equal');
ctx.project.meta.title='지형 조수 재편집 QA';ctx.project.startMapId=m.id;ctx.project.startPos={x:4,y:58};
let store=await initLocalProjectStore({projectDir:folder});const projectId=store.info().projectId;
try{const r=await store.saveSerialized(JSON.stringify(ctx.project));assert.equal(r.kind,'saved');}finally{store.close();}
store=await openLocalProjectStore({projectDir:folder});const load=store.loadSnapshot()!;store.close();
assert.equal(JSON.stringify(load.project.maps[m.id]),JSON.stringify(map()));checks.push('canonical SQLite save and reload are equal');
const proof={checks,projectId,folder,revision:load.revision,canonicalReload:true,mapId:m.id,fixture:{ridgeId:ridge.featureId,roofPlacementId:added.placementId,roadId:road.featureId},exposedTools:exposed,
 mapSha256:createHash('sha256').update(JSON.stringify(load.project.maps[m.id])).digest('hex')};
fs.writeFileSync(path.join(out,'observations.json'),JSON.stringify(proof,null,2));fs.writeFileSync(path.join(out,'calls.json'),JSON.stringify(calls,null,2));
fs.writeFileSync(path.join(out,'project.json'),JSON.stringify(load.project));console.log(JSON.stringify({...proof,exposedTools:exposed.length},null,2));
