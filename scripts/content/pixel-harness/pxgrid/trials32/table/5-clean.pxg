// 5단계 정리: 외톨이 치우기, 다리 판 밑 그늘 줄을 덩이로, 결 몇 줄에 빛 쪽 짝(8)을 대어 파인 결로,
// 이음 틈은 앞쪽으로 갈수록 옅게(판이 붙어 보이게), 앞 입술 이음 자리 한 칸 어둡게.
@base 4-texture.pxg
@layer main
// 뒤 테 홈: 테와 이어지게 두 칸
@px 16 3 5  31 3 5  47 3 5
// 다리 판 밑 줄과 발끝(외톨이 4 → 덩이)
@block 3 52
55443
@block 56 52
55443
@block 3 61
.443.
@block 56 61
.443.
// 파인 결: 결 왼쪽(빛 쪽)에 밝은 짝
@block 5 8
8 *5
@block 23 12
8 *6
@block 34 25
8 *6
@block 55 12
8 *5
@block 52 37
8 *4
// 이음 틈 앞쪽은 옅게 (y38~43 을 6으로)
@block 16 38
6 *6
@block 31 40
6 *4
@block 47 37
6 *7
// 결 끊긴 점 잇기(1px 옆으로 흐르는 결)
@px 12 29 6  6 14 6  25 22 6  21 35 6  54 44 6
// 앞 두께 오른끝 어둡게, 왼끝 모서리 밝게
@px 2 46 7  3 46 7  61 47 4  61 48 4
// 윤곽 비 0.47 → 0.6 근처로: 앞 두께 밑줄과 다리 오른 테를 한 단 올린다(3 → 4, 그 위 줄 4 → 5)
@block 2 49
555555555555555555555555555555555555555555555555555555555554
@block 2 50
444444444444444444444444444444444444444444444444444444444444
@block 7 53
4 *8
@block 60 53
4 *8
@block 3 61
.444.
