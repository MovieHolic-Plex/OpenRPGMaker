// 식탁 2×2칸(64×64). 1단계 실루엣: 윗면(y2~45)이 높이의 ¾, 앞 두께 5px(y46~50), 앞다리 둘.
// 뒷다리는 윗면 밑에 숨는다(이 시점에서 보이지 않는다).
@size 64 64
@cell 32
@palette ../../palettes/interior.pal
@layer shadow
@layer main
@block 0 0
