#!/bin/sh
# electron-builder 가 리눅스에서 NSIS 설치판을 만들 때 언인스톨러를 꺼내려고 중간 설치기를 wine 으로 실행한다.
# 릴리스 러너(mdc2)에는 wine 이 없고 sudo 도 없다. 같은 일을 하는 app-builder-lib 의 순수 JS 경로를 부른다
# (USE_SYSTEM_WINE=true 와 PATH 앞자리로 이 파일이 "wine" 으로 잡힌다). 이유·실측은 extract-uninstaller.cjs.
exec node "$(dirname "$0")/extract-uninstaller.cjs" "$@"
