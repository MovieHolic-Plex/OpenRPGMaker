DEV_SERVER_PORT=9173
# 게이트웨이 경로(동일 오리진 프록시). VITE_LLM_API_URL 이 상대 경로(/api/ai)면
# vite 프록시가 서버 측에서 Authorization 을 주입하므로 클라이언트에 키가 필요 없다(proxyAuth).
#   /api/ai   — apitopia(apitopia.labs.mengmota.com), 서버 전용 APITOPIA_API_KEY
# 게이트웨이 키는 서버 전용(non-VITE — 클라이언트 번들에 인라인되지 않음) 에 둔다.
# 절대 URL(https://...)을 직접 칠 때만 VITE_LLM_API_KEY (클라이언트 노출 주의) 를 쓴다.
VITE_LLM_API_URL=/api/ai
# APITOPIA_API_KEY=  # .env.local 에 서버 전용 키를 넣는다 (gitignored)
# AI 활동 로그 디스크 미러(output/ai-activity/). 미지정이면 첫 요청으로 미들웨어 유무를 판별하고
# 실패 시 스스로 끈다. "0" 으로 빌드하면 번들에서 완전히 제거된다.
# VITE_AI_ACTIVITY_DISK_MIRROR=0

# Tailscale/원격 preview 공개 origin. Google Antigravity 는 데스크톱 클라라
# redirect_uri 가 http://127.0.0.1:PORT/oauth-callback 만 통과한다.
# 로그인 시작 URL 만 이 origin 의 /oauth/launch 로 바꾸고, 돌아온 localhost
# 콜백 URL 은 AI 설정에 붙여 넣으면 서버가 대신 받아 완료한다.
# OPRN_PUBLIC_ORIGIN=http://mdc-server:9888

# ── CC0 BGM 카탈로그 (281곡 / 약 1.304 GB) ──────────────────────────────────
# 권장: npm run bgm:install 로 GitHub Release 팩 설치 후 이 설정을 비워 둔다.
# 공개 저장소 Release에서 받는다. gh가 없으면 --archive <경로>로 수동 설치한다.
# 비우면 같은 오리진 /assets/cc0/audio/catalog/ 를 사용한다.
# 팩 미설치 상태에서는 Git에 포함된 카탈로그 기본 3곡만 로컬에 있다.
# 기존 CDN 사용자는 이 값을 유지할 수 있다. CDN 값은 로컬 설치보다 우선한다.
# 설정 변경 뒤 개발 서버 재시작 / 프로덕션 재빌드 필요. README와 openwiki/bgm-catalog.md 참고.
# VITE_BGM_CDN_BASE=https://<space>.<region>.cdn.digitaloceanspaces.com
#
# 에디터의 리소스 선택 창에서 팩을 바로 받을 수 있다(음악 카탈로그 한정). 이 기능은
# 서버 측에서 gh 를 실행하고 디스크에 1.3GB 를 쓰므로, 기본적으로 루프백(127.0.0.1)
# 에서만 동작한다. 네트워크에 열어 두는 것을 기본값으로 삼지 않는다.
# mdc-server:9888 처럼 원격 주소로 에디터를 열어 쓸 때만 gitignored .env.local 에 넣는다.
# 서버 전용(non-VITE — 클라이언트 번들에 인라인되지 않는다). 설정 뒤 서버 재시작 필요.
# OPRN_BGM_INSTALL_REMOTE=1
#
# 업로드 자격증명 — 서버/스크립트 전용(non-VITE, 클라이언트 번들에 인라인되지 않음).
# .env.local 에 넣는다 (gitignored). 쓰는 곳: scripts/upload-bgm-to-spaces.mjs
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_BUCKET=
# DO_SPACES_REGION=nyc3
# DO_SPACES_CDN_BASE=  # 커스텀 도메인을 쓸 때만. 비우면 <bucket>.<region>.cdn.digitaloceanspaces.com

# npm start: 기존 SQLite 프로젝트 폴더 (미설정 시 저장 없는 화면을 띄우지 않고 종료)
# 먼저 npm run build:packaged && npm run build:electron. 팀 호스트 접속에는 로그인 필요.
# OPRN_PROJECT_DIR=/absolute/path/to/project
