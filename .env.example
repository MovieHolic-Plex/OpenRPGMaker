DEV_SERVER_PORT=9173
# 게이트웨이 경로(동일 오리진 프록시). VITE_LLM_API_URL 이 상대 경로(/api/ai, /api/qwen, /api/cpen)면
# vite 프록시가 서버 측에서 Authorization 을 주입하므로 클라이언트에 키가 필요 없다(proxyAuth).
#   /api/ai   — apitopia(apitopia.labs.mengmota.com), 서버 전용 APITOPIA_API_KEY
#   /api/qwen — qwencloud(알리바바 MaaS), 서버 전용 QWENCLOUD_API_KEY
#   /api/cpen — cpenrouter.space(OpenAI 호환), 서버 전용 CPENROUTER_API_KEY
# 게이트웨이 키는 서버 전용(non-VITE — 클라이언트 번들에 인라인되지 않음) 에 둔다.
# 절대 URL(https://...)을 직접 칠 때만 VITE_LLM_API_KEY (클라이언트 노출 주의) 를 쓴다.
VITE_LLM_API_URL=/api/ai
# APITOPIA_API_KEY=  # .env.local 에 서버 전용 키를 넣는다 (gitignored)
# QWENCLOUD_API_KEY=  # qwencloud(알리바바 MaaS) 경로 /api/qwen 의 서버 전용 키 (non-VITE — 클라이언트 번들에 인라인되지 않음). .env.local 에 넣는다 (gitignored)
# CPENROUTER_API_KEY=  # cpenrouter.space(OpenAI 호환) 경로 /api/cpen 의 서버 전용 키 (non-VITE — 클라이언트 번들에 인라인되지 않음). .env.local 에 넣는다 (gitignored)
VITE_SUPABASE_URL=http://dbserver:8100
VITE_SUPABASE_PROJECT_ID=rpg-zzu-house-template-gallery
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# Admin-only migration DSN. Put the real value in gitignored .env.local, never in a VITE_ variable.
# SUPABASE_DB_URL=postgresql://postgres:<password>@dbserver:5432/postgres

# Tailscale/원격 preview 공개 origin. Google Antigravity 는 데스크톱 클라라
# redirect_uri 가 http://127.0.0.1:PORT/oauth-callback 만 통과한다.
# 로그인 시작 URL 만 이 origin 의 /oauth/launch 로 바꾸고, 돌아온 localhost
# 콜백 URL 은 AI 설정에 붙여 넣으면 서버가 대신 받아 완료한다.
# RPG_ZZU_PUBLIC_ORIGIN=http://mdc-server:9888

# ── CC0 BGM 카탈로그 (281곡 / 1.21GB) ────────────────────────────────────────
# 오디오는 레포에 없다. DigitalOcean Spaces 에 올리고 이 베이스 URL 로 서빙한다.
# 비우면 같은 오리진 /assets/cc0/audio/catalog/ 로 떨어진다 — 레포에 커밋된 스타터 3곡만 들린다.
# 자세한 배선: openwiki/bgm-catalog.md
# VITE_BGM_CDN_BASE=https://<space>.<region>.cdn.digitaloceanspaces.com
#
# 업로드 자격증명 — 서버/스크립트 전용(non-VITE, 클라이언트 번들에 인라인되지 않음).
# .env.local 에 넣는다 (gitignored). 쓰는 곳: scripts/upload-bgm-to-spaces.mjs
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_BUCKET=
# DO_SPACES_REGION=nyc3
# DO_SPACES_CDN_BASE=  # 커스텀 도메인을 쓸 때만. 비우면 <bucket>.<region>.cdn.digitaloceanspaces.com
