DEV_SERVER_PORT=9173
# 게이트웨이 경로(동일 오리진 프록시). VITE_LLM_API_URL 이 상대 경로(/api/ai, /api/qwen, /api/cpen)면
# vite 프록시가 서버 측에서 Authorization 을 주입하므로 클라이언트에 키가 필요 없다(proxyAuth).
#   /api/ai   — apitopia(apitopia.labs.mengmota.com), 서버 전용 APITOPIA_API_KEY
#   /api/qwen — qwencloud(알리바바 MaaS), 서버 전용 QWENCLOUD_API_KEY
#   /api/cpen — cpenrouter.space(OpenAI 호환), 서버 전용 CPENROUTER_API_KEY
# 게이트웨이 키는 서버 전용(non-VITE — 클라이언트 번들에 인라인되지 않음) 에 둔다.
# 절대 URL(https://...)을 직접 칠 때만 VITE_LLM_API_KEY (클라이언트 노출 주의) 를 쓴다.
VITE_LLM_API_URL=/api/ai
# APITOPIA_API_KEY=  # .env.local 에 서버 전용 키를 넣는다 (gitignored)
# QWENCLOUD_API_KEY=  # qwencloud(알리바바 MaaS) 경로 /api/qwen 의 서버 전용 키 (non-VITE — 클라이언트 번들에 인라인되지 않음). .env.local 에 넣는다 (gitignored)
# CPENROUTER_API_KEY=  # cpenrouter.space(OpenAI 호환) 경로 /api/cpen 의 서버 전용 키 (non-VITE — 클라이언트 번들에 인라인되지 않음). .env.local 에 넣는다 (gitignored)
VITE_SUPABASE_URL=http://dbserver:8100
VITE_SUPABASE_PROJECT_ID=rpg-zzu-house-template-gallery
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
