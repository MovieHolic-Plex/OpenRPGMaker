+import { canMove, inBounds } from "@/project/collision";
+import { setAudioState } from "@/project/session";
+import { store } from "@/project/store";
+import { resolveEventSpriteTexture } from "@/player/eventSpriteResources";
+import type { Dir } from "@/player/input";
+import { npcMoveDurationMs, npcMoveIntervalMs } from "@/player/playScenePageMoveRoutes";
+import type { AutonomousMover } from "@/player/playSceneTypes";
+import { resourceDisplayName } from "@/player/resourceDisplay";
+import type { MoveCommand } from "@/project/types";
+import type {
+  AutonomousNpcSceneContext,
+  AutonomousNpcSprite,
+  MovementDelta,
+} from "@/player/playSceneAutonomousTypes";
+import { applySpriteAlpha, setNpcIdleFrame } from "@/player/playSceneAutonomousSprites";
+import type { RuntimeEventView } from "@/player/runtimeEventState";
+
+const DIRECTIONS: readonly Dir[] = ["up", "right", "down", "left"];
+const DEFAULT_JUMP_DISTANCE = 2;
+
+export function nextMoveCommand(mover: AutonomousMover): MoveCommand {
+  if (mover.strategy === "approach") return { kind: "moveTowardPlayer" };
+  if (mover.strategy === "random") return mover.moves[randomMoveIndex(mover.moves.length)] ?? { kind: "wait" };
+  return mover.moves[mover.step % mover.moves.length] ?? { kind: "wait" };
+}
+
+export function movementDeltaForCommand(
+  scene: AutonomousNpcSceneContext,
+  eventId: string,
+  mover: AutonomousMover,
+  command: MoveCommand
+): MovementDelta | null {
+  switch (command.kind) {
+    case "move":
+      return { ...commandDelta(command.dir), face: command.dir };
+    case "moveDiagonal": {
+      const x = command.horizontal === "right" ? 1 : -1;
+      const y = command.vertical === "down" ? 1 : -1;
+      return { x, y, face: command.horizontal };
+    }
+    case "moveRandom": {
+      const dir = randomDirection();
+      return { ...commandDelta(dir), face: dir };
+    }
+    case "moveTowardPlayer":
+      return playerRelativeMove(scene, eventId, true);
+    case "moveAwayFromPlayer":
+      return playerRelativeMove(scene, eventId, false);
+    case "stepForward":
+      return { ...commandDelta(mover.facing), face: mover.facing };
+    case "jump": {
+      const delta = jumpDelta(mover, command);
+      return { ...delta, face: facingForDelta(delta.x, delta.y, mover.facing), jump: true };
+    }
+    default:
+      return null;
+  }
+}
+
+export function executeInstantCommand(
+  scene: AutonomousNpcSceneContext,
+  eventId: string,
+  mover: AutonomousMover,
+  command: MoveCommand,
+  view: RuntimeEventView,
+  baseFrame: number,
+  sprite: AutonomousNpcSprite | undefined
+): boolean {
+  switch (command.kind) {
+    case "wait":
+      return true;
+    case "land":
+      setNpcIdleFrame(sprite, baseFrame, mover.facing, view.animationType, mover.animationEnabled);
+      return true;
+    case "turn":
+      turnNpc(mover, sprite, baseFrame, command.dir, view.animationType);
+      return true;
+    case "turnRelative":
+      turnNpc(mover, sprite, baseFrame, relativeTurn(mover.facing, command.turn), view.animationType);
+      return true;
+    case "turnRandom":
+      turnNpc(mover, sprite, baseFrame, randomDirection(), view.animationType);
+      return true;
+    case "turnTowardPlayer": {
+      const dir = playerRelativeDirection(scene, eventId, true);
+      if (dir) turnNpc(mover, sprite, baseFrame, dir, view.animationType);
+      return true;
+    }
+    case "turnAwayFromPlayer": {
+      const dir = playerRelativeDirection(scene, eventId, false);
+      if (dir) turnNpc(mover, sprite, baseFrame, dir, view.animationType);
+      return true;
+    }
+    case "setDirectionFix":
+      mover.directionFix = command.enabled;
+      return true;
+    case "setThrough":
+      mover.through = command.enabled;
+      return true;
+    case "setAnimation":
+      mover.animationEnabled = command.enabled;
+      return true;
+    case "changeOpacity":
+      mover.opacity = clampOpacity(mover.opacity + command.delta);
+      applySpriteAlpha(sprite, mover.opacity);
+      return true;
+    case "setSwitch":
+      applyRouteSwitch(scene, command);
+      return true;
+    case "changeSpeed":
+      mover.speedRank = clampRank(mover.speedRank + command.delta);
+      mover.moveDurationMs = npcMoveDurationMs(mover.speedRank);
+      return true;
+    case "changeFrequency":
+      mover.frequencyRank = clampRank(mover.frequencyRank + command.delta);
+      mover.moveIntervalMs = npcMoveIntervalMs(mover.frequencyRank);
+      return true;
+    case "changeGraphic":
+      applyGraphicChange(command.spriteId, view, sprite);
+      return true;
+    case "playSe":
+      playRouteSound(scene, command.resourceId);
+      return true;
+    default:
+      return false;
+  }
+}
+
+export function applyFacing(mover: AutonomousMover, dir: Dir): Dir {
+  if (!mover.directionFix) mover.facing = dir;
+  return mover.facing;
+}
+
+export function canNpcMove(
+  project: ReturnType<typeof store.getCurrent>,
+  scene: AutonomousNpcSceneContext,
+  mover: AutonomousMover,
+  position: { readonly x: number; readonly y: number },
+  movement: MovementDelta,
+  nx: number,
+  ny: number
+): boolean {
+  if (movement.jump || mover.through) return inBounds(scene.map, nx, ny);
+  if (movement.x !== 0 && movement.y !== 0) {
+    const hx = position.x + movement.x;
+    const vy = position.y + movement.y;
+    return (
+      (canMove(project, scene.map, position.x, position.y, hx, position.y) &&
+        canMove(project, scene.map, hx, position.y, nx, ny)) ||
+      (canMove(project, scene.map, position.x, position.y, position.x, vy) &&
+        canMove(project, scene.map, position.x, vy, nx, ny))
+    );
+  }
+  return canMove(project, scene.map, position.x, position.y, nx, ny);
+}
+
+function applyRouteSwitch(scene: AutonomousNpcSceneContext, command: Extract<MoveCommand, { kind: "setSwitch" }>): void {
+  const switchId = command.switchId.trim();
+  if (switchId.length === 0) return;
+  scene.session.switches[switchId] = command.value;
+  scene.refreshRuntimeSurfaces?.();
+}
+
+function playerRelativeMove(
+  scene: AutonomousNpcSceneContext,
+  eventId: string,
+  towardPlayer: boolean
+): MovementDelta | null {
+  const dir = playerRelativeDirection(scene, eventId, towardPlayer);
+  return dir ? { ...commandDelta(dir), face: dir } : null;
+}
+
+function playerRelativeDirection(scene: AutonomousNpcSceneContext, eventId: string, towardPlayer: boolean): Dir | null {
+  const event = scene.map.events.find((entry) => entry.id === eventId);
+  const position = event ? scene.eventPositions[eventId] ?? { x: event.x, y: event.y } : { x: scene.tileX, y: scene.tileY };
+  const dx = scene.tileX - position.x;
+  const dy = scene.tileY - position.y;
+  if (Math.abs(dx) >= Math.abs(dy) && dx !== 0) {
+    return towardPlayer ? (dx > 0 ? "right" : "left") : dx > 0 ? "left" : "right";
+  }
+  if (dy !== 0) return towardPlayer ? (dy > 0 ? "down" : "up") : dy > 0 ? "up" : "down";
+  return null;
+}
+
+function turnNpc(
+  mover: AutonomousMover,
+  sprite: AutonomousNpcSprite | undefined,
+  baseFrame: number,
+  dir: Dir,
+  animationType: string
+): void {
+  const frameDir = applyFacing(mover, dir);
+  setNpcIdleFrame(sprite, baseFrame, frameDir, animationType, mover.animationEnabled);
+}
+
+function randomMoveIndex(length: number): number {
+  if (length <= 0) return 0;
+  return Math.floor(Math.random() * length);
+}
+
+function randomDirection(): Dir {
+  return DIRECTIONS[randomMoveIndex(DIRECTIONS.length)] ?? "down";
+}
+
+function relativeTurn(dir: Dir, turn: Extract<MoveCommand, { kind: "turnRelative" }>["turn"]): Dir {
+  const index = DIRECTIONS.indexOf(dir);
+  const offset = turn === "right90" ? 1 : turn === "left90" ? -1 : turn === "turn180" ? 2 : Math.random() < 0.5 ? -1 : 1;
+  return DIRECTIONS[(index + offset + DIRECTIONS.length) % DIRECTIONS.length] ?? dir;
+}
+
+function jumpDelta(
+  mover: AutonomousMover,
+  command: Extract<MoveCommand, { kind: "jump" }>
+): { readonly x: number; readonly y: number } {
+  if (command.dx !== 0 || command.dy !== 0) return { x: command.dx, y: command.dy };
+  const delta = commandDelta(mover.facing);
+  return { x: delta.x * DEFAULT_JUMP_DISTANCE, y: delta.y * DEFAULT_JUMP_DISTANCE };
+}
+
+function facingForDelta(x: number, y: number, fallback: Dir): Dir {
+  if (Math.abs(x) >= Math.abs(y) && x !== 0) return x > 0 ? "right" : "left";
+  if (y !== 0) return y > 0 ? "down" : "up";
+  return fallback;
+}
+
+function clampRank(value: number): number {
+  if (!Number.isFinite(value)) return 3;
+  return Math.min(8, Math.max(1, Math.trunc(value)));
+}
+
+function clampOpacity(value: number): number {
+  if (!Number.isFinite(value)) return 255;
+  return Math.min(255, Math.max(0, Math.trunc(value)));
+}
+
+function applyGraphicChange(
+  spriteId: string,
+  view: RuntimeEventView,
+  sprite: AutonomousNpcSprite | undefined
+): void {
+  const normalized = spriteId.trim();
+  if (!normalized || !sprite) return;
+  const texture = resolveEventSpriteTexture(store.getCurrent(), normalized, view.page?.graphic.pattern);
+  if (texture) sprite.setTexture(texture.texture, texture.frame);
+}
+
+function playRouteSound(scene: AutonomousNpcSceneContext, resourceId: string): void {
+  const normalized = resourceId.trim();
+  if (!normalized) return;
+  setAudioState(scene.session, { channel: "se", resourceId: normalized, loop: false });
+  scene.showRuntimeOverlay?.("audio-indicator", resourceDisplayName(normalized, normalized));
+}
+
+function commandDelta(dir: "left" | "right" | "up" | "down"): { x: number; y: number } {
+  switch (dir) {
+    case "left":
+      return { x: -1, y: 0 };
+    case "right":
+      return { x: 1, y: 0 };
+    case "up":
+      return { x: 0, y: -1 };
+    case "down":
+      return { x: 0, y: 1 };
+  }
+}
+

