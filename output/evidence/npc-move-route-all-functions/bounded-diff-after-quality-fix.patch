+  100% {
+    filter: brightness(1) saturate(1);
+    opacity: 1;
+  }
+}
+
+@keyframes rm-title-select-juice {
+  0% {
+    filter: brightness(1.2);
+  }
+  100% {
+    filter: brightness(1);
+  }
+}
+
+@keyframes rm-title-confirm-juice {
+  0% {
+    filter: brightness(1.58) contrast(1.12);
+  }
+  100% {
+    filter: brightness(1) contrast(1);
+  }
+}
+
+@keyframes rm-status-menu-open-juice {
+  0% {
+    opacity: 0.82;
+    transform: translateY(-4px) scale(var(--play-scale-x, 1), var(--play-scale-y, 1));
+  }
+  100% {
+    opacity: 1;
+    transform: translateY(0) scale(var(--play-scale-x, 1), var(--play-scale-y, 1));
+  }
+}
+
+@keyframes rm-status-menu-select-juice {
+  0% {
+    filter: brightness(1.24);
+    transform: translateX(1px) scale(var(--play-scale-x, 1), var(--play-scale-y, 1));
+  }
+  100% {
+    filter: brightness(1);
+    transform: translateX(0) scale(var(--play-scale-x, 1), var(--play-scale-y, 1));
+  }
+}
+
+@keyframes rm-status-menu-confirm-juice {
+  0% {
+    filter: brightness(1.34) contrast(1.1);
+    transform: translateY(1px) scale(var(--play-scale-x, 1), var(--play-scale-y, 1));
+  }
+  100% {
+    filter: brightness(1) contrast(1);
+    transform: translateY(0) scale(var(--play-scale-x, 1), var(--play-scale-y, 1));
+  }
+}
+
+@keyframes rm-status-menu-cancel-juice {
+  0% {
+    filter: brightness(0.82);
+    transform: translateX(-2px) scale(var(--play-scale-x, 1), var(--play-scale-y, 1));
+  }
+  100% {
+    filter: brightness(1);
+    transform: translateX(0) scale(var(--play-scale-x, 1), var(--play-scale-y, 1));
+  }
+}
