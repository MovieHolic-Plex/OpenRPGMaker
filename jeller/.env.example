# 클라이언트에서 읽는 환경변수 (VITE_ 접두사 → 번들에 인라인됨)
# 주의: API 키는 여기 두지 말 것. 키는 Supabase Edge Function 시크릿(MCGA_OPENAI_KEY)으로만.

# 자체 호스팅 Supabase. dev에선 vite proxy(/db, /fn)로 동일 출처 우회.
VITE_SUPABASE_URL=http://192.168.100.121:8000
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# GPT 모델 (왕 판결). 실제 키는 서버(Edge Function)에만.
VITE_KING_MODEL=gpt-5.4-mini
