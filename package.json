{
  "name": "rpg-zzu",
  "version": "0.1.0",
  "description": "웹 기반 탑뷰 타일 JRPG 메이커 (MVP)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0 --port 9999 --strictPort",
    "dev:worktree": "vite --configLoader runner --host 127.0.0.1 --strictPort",
    "wt": "node scripts/agent-worktree.mjs",
    "qwen": "node scripts/qwen-worker.mjs",
    "gates": "node scripts/verify-gates.mjs",
    "dev:keep": "node scripts/dev-keepalive.mjs",
    "dev:keep:detached": "node scripts/dev-keepalive-supervisor.mjs --detach",
    "mcp:assistant": "node scripts/rpgzzu-assistant-mcp.mjs",
    "ai:oauth": "node scripts/chatgpt-oauth-companion.mjs",
    "start": "node scripts/start-preview.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build --configLoader runner && npm run build:player",
    "build:app": "vite build --configLoader runner",
    "build:fast": "vite build --configLoader runner",
    "build:player": "vite build --config vite.player.config.ts --configLoader runner && node scripts/build-player-sdk.mjs",
    "build:community": "node scripts/build-community.mjs",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "ontology:query": "node scripts/ontology-query.mjs",
    "ontology:classify": "node scripts/ontology-query.mjs classify",
    "ontology:evaluate": "node scripts/ontology-query.mjs evaluate",
    "ontology:docs": "node scripts/ontology-query.mjs docs --write docs/ontology/development-ontology.md",
    "ontology:check": "node scripts/ontology-check.mjs",
    "generate:window-skin": "node scripts/generate-window-skin.mjs",
    "generate:effect-sheets": "node scripts/gen-effect-sheets.mjs",
    "generate:effect-showcase": "node scripts/gen-generated-effect-showcase.mjs",
    "perf:bench": "node scripts/perf-benchmark.mjs",
    "openwiki:cpen": "node scripts/openwiki-cpen.mjs",
    "openwiki:verify": "node scripts/verify-openwiki-editor-wiki.mjs",
    "test": "node scripts/run-vitest.mjs run --configLoader bundle",
    "test:parity": "node scripts/run-vitest.mjs run test/parity --configLoader bundle",
    "test:node": "node scripts/run-node-tests.mjs",
    "test:ai-oauth": "node scripts/run-node-tests.mjs ohMyPi",
    "test:oh-my-pi": "node scripts/run-node-tests.mjs ohMyPi && bun test test/ohMyPiComplete.bun.test.ts",
    "test:e2e": "playwright test",
    "construction:harness": "node scripts/run-construction-harness.mjs",
    "browser-verify:genre": "tsx scripts/browser-verify-genre-presets.mts",
    "test:watch": "node scripts/run-vitest.mjs --configLoader bundle"
  },
  "dependencies": {
    "jimp": "^0.16.13",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "^17.4.0",
    "@playwright/test": "^1.61.0",
    "happy-dom": "^20.10.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "3.2.4"
  }
}
