{
  "name": "oprn",
  "version": "0.178.0",
  "description": "웹 기반 탑뷰 타일 JRPG 메이커 (MVP)",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "electron:build": "node scripts/build-electron.mjs",
    "electron:dev": "node scripts/build-electron.mjs && node scripts/electron-dev.mjs",
    "electron:start": "node scripts/build-electron.mjs && vite build --configLoader runner && electron .",
    "electron:package": "node scripts/build-electron.mjs && vite build --configLoader runner && electron-builder --config scripts/electron-builder.config.mjs",
    "mac:launch": "node scripts/mac-launch.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "bgm:pack": "vite-node --script scripts/build-bgm-release.mts",
    "bgm:install": "node scripts/install-bgm.mjs",
    "bgm:verify": "node scripts/install-bgm.mjs --verify",
    "stills:pack": "node scripts/pack-opening-stills.mjs",
    "stills:install": "node scripts/install-opening-stills.mjs",
    "stills:verify": "node scripts/install-opening-stills.mjs --verify",
    "test:mac-onboarding": "node --test test/macLauncher.test.mjs test/setupLocal.test.mjs",
    "dev": "node scripts/dev-server.mjs main",
    "dev:worktree": "node scripts/dev-server.mjs worktree",
    "wt": "node scripts/agent-worktree.mjs",
    "gates": "node scripts/verify-gates.mjs",
    "gates:css": "node scripts/check-css-budget.mjs && node scripts/check-css-graph.mjs && node scripts/check-css-live-classes.mjs && node scripts/check-css-surfaces.mjs --enforce all && node scripts/check-css-winners.mjs && node scripts/check-dead-css-classes.mjs",
    "gates:css:save": "node scripts/check-css-budget.mjs --save-baseline",
    "gates:css:live": "node scripts/check-css-live-classes.mjs",
    "audit:db-css-ownership": "node scripts/audit-db-css-ownership.mjs",
    "gates:barrel": "node scripts/check-barrel-imports.mjs",
    "gates:self-hosted": "node scripts/check-self-hosted-workflows.mjs",
    "gates:surface": "node scripts/check-surface-gates.mjs",
    "gates:surface:audit": "node scripts/audit-gate-mutations.mjs",
    "check:player-tokens": "node scripts/check-player-bundle-tokens.mjs",
    "gates:dead-css": "node scripts/check-dead-css-classes.mjs",
    "gates:dead-css:report": "node scripts/check-dead-css-classes.mjs --report",
    "measure:css-deletable": "node scripts/measure-css-deletable.mjs",
    "measure:db-map-tabs": "node scripts/measure-db-map-tabs.mjs",
    "dev:keep": "node scripts/dev-keepalive.mjs",
    "dev:keep:detached": "node scripts/dev-keepalive-supervisor.mjs --detach",
    "mcp:assistant": "node scripts/oprn-assistant-mcp.mjs",
    "ai:oauth": "node scripts/chatgpt-oauth-companion.mjs",
    "ai:log": "node scripts/list-ai-activity.mjs",
    "ai:trace": "node scripts/list-ai-turn-timing.mjs",
    "qa:game": "bun scripts/qa-game/cli.mts",
    "edit:log": "node scripts/list-edit-activity.mjs",
    "commit:log": "node scripts/list-project-commits.mjs",
    "version:info": "node scripts/app-version.mjs",
    "release": "node scripts/release.mjs",
    "release:auto": "node scripts/release-auto.mjs",
    "start": "node scripts/start-preview.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build --configLoader runner && npm run build:player && npm run build:standalone:bundle && npm run archive:runtime",
    "archive:runtime": "vite-node scripts/archive-runtime.mts",
    "build:app": "vite build --configLoader runner",
    "build:fast": "vite build --configLoader runner",
    "build:electron": "node scripts/build-electron.mjs",
    "build:packaged": "vite build --mode packaged --configLoader runner",
    "package": "npm run build:packaged && npm run build:electron && electron-builder --config electron-builder.config.mjs",
    "package:dir": "npm run build:packaged && npm run build:electron && electron-builder --config electron-builder.config.mjs --dir",
    "electron:smoke": "npm run build:fast && npm run build:electron && playwright test -c playwright.electron.config.ts",
    "qa:package": "node scripts/qa/verifyPackagedApp.mjs",
    "build:player": "vite build --config vite.player.config.ts --configLoader runner && node scripts/build-player-sdk.mjs",
    "build:community": "node scripts/build-community.mjs",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "typecheck:app": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:export-qa": "tsc -p scripts/tsconfig.json",
    "ontology:query": "node scripts/ontology-query.mjs",
    "ontology:classify": "node scripts/ontology-query.mjs classify",
    "ontology:evaluate": "node scripts/ontology-query.mjs evaluate",
    "ontology:docs": "node scripts/ontology-query.mjs docs --write docs/ontology/development-ontology.md",
    "ontology:check": "node scripts/ontology-check.mjs",
    "terminology:check": "node scripts/terminology-check.mjs",
    "terminology:docs": "node scripts/terminology-docs.mjs --write docs/terminology/product-terminology.md",
    "generate:window-skin": "node scripts/generate-window-skin.mjs",
    "assets:slice-faces": "node scripts/slice-faceset-sheets.mjs",
    "generate:effect-sheets": "node scripts/gen-effect-sheets.mjs",
    "generate:effect-showcase": "node scripts/gen-generated-effect-showcase.mjs",
    "clean:title-logo": "node scripts/clean-title-logo-transparency.mjs",
    "perf:bench": "node scripts/perf-benchmark.mjs",
    "openwiki:index": "node scripts/openwiki-index.mjs",
    "openwiki:verify": "node scripts/verify-openwiki-editor-wiki.mjs",
    "test": "node scripts/run-vitest.mjs run --configLoader bundle",
    "test:changed": "node scripts/run-vitest-changed.mjs",
    "test:parity": "node scripts/run-vitest.mjs run test/parity --configLoader bundle --maxWorkers=2 --minWorkers=1",
    "test:node": "node scripts/run-node-tests.mjs",
    "test:ai-oauth": "node scripts/run-node-tests.mjs ohMyPi",
    "test:oh-my-pi": "node scripts/run-node-tests.mjs ohMyPi && bun test test/ohMyPiComplete.bun.test.ts",
    "test:e2e": "playwright test",
    "shots:css": "playwright test -c playwright.css-shots.config.ts",
    "shots:css:update": "playwright test -c playwright.css-shots.config.ts --update-snapshots",
    "qa:runtime": "node scripts/runtime-qa.mjs",
    "qa:export": "vite-node --script scripts/qa-export-playability.mts --",
    "qa:runtime:gate": "playwright test --config playwright.runtime.config.ts",
    "construction:harness": "node scripts/run-construction-harness.mjs",
    "browser-verify:genre": "tsx scripts/browser-verify-genre-presets.mts",
    "verify:genre-packs": "vite-node --script scripts/verify-genre-pack-receipts.mts",
    "test:quarantine": "node scripts/run-vitest.mjs run --config vitest.quarantine.config.ts --maxWorkers=2 --minWorkers=1",
    "test:watch": "node scripts/run-vitest.mjs --configLoader bundle",
    "build:standalone": "npm run build:standalone:bundle && npx tsx scripts/build-standalone-html.mts",
    "qa:standalone": "node scripts/qa-standalone-boot.mjs",
    "build:standalone:bundle": "vite build --config vite.standalone.config.ts --configLoader runner",
    "serve:project": "node scripts/oprn-serve.mjs",
    "harness": "vite-node --script scripts/harness.mts --"
  },
  "dependencies": {
    "@oh-my-pi/pi-agent-core": "^17.4.0",
    "god-tibo-imagen": "^0.4.1",
    "jimp": "^0.16.13",
    "node-unrar-js": "2.0.2",
    "phaser": "^3.90.0",
    "tar": "7.5.22",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "^17.4.0",
    "@playwright/test": "^1.61.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "fix-webm-duration": "^1.0.6",
    "happy-dom": "^20.10.6",
    "pngjs": "3.4.0",
    "ts-ebml": "^3.0.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-node": "3.2.4",
    "vitest": "3.2.4",
    "webm-duration-fix": "^1.0.4"
  }
}
