{
  "name": "rpg-zzu",
  "version": "0.1.0",
  "description": "웹 기반 탑뷰 타일 JRPG 메이커 (MVP)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
