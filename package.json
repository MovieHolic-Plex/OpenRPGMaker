{
  "name": "rpg-zzu",
  "version": "0.1.0",
  "description": "웹 기반 탑뷰 타일 JRPG 메이커 (MVP)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner && npm run build:player",
    "build:player": "vite build --config vite.player.config.ts --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit",
    "ontology:query": "node scripts/ontology-query.mjs",
    "ontology:classify": "node scripts/ontology-query.mjs classify",
    "ontology:evaluate": "node scripts/ontology-query.mjs evaluate",
    "ontology:docs": "node scripts/ontology-query.mjs docs --write docs/ontology/development-ontology.md",
    "ontology:check": "node scripts/ontology-check.mjs",
    "generate:window-skin": "node scripts/generate-window-skin.mjs",
    "perf:bench": "node scripts/perf-benchmark.mjs",
    "openwiki:cpen": "node scripts/openwiki-cpen.mjs",
    "openwiki:verify": "node scripts/verify-openwiki-editor-wiki.mjs",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "test:watch": "vitest --configLoader runner"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "happy-dom": "^20.10.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
