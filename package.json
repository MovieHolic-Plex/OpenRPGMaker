    "phaser": "^3.90.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  }
}
