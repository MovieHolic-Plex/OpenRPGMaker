debug.log
process_temp.js
qa-*.png
*-qa.png
rpg-zzu-*.png
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
# Windows 예약 장치명 — 셸에서 `> nul` 오타로 생긴다. git 이 인덱싱에 실패해
# `git add -A` 가 통째로 죽으므로(워크트리 스냅샷 차단) 반드시 무시한다.
nul
.vscode/*
!.vscode/extensions.json

# tooling state / QA artifacts / infra handoff (never commit)
.omc/
.playwright-mcp/
evidence/
handoff.md
# 세션 로컬 상태·일회성 산출물 (never commit)
/.mcp.json
/mcps/
/output/
# legacy root tmp-* probes now live under scratch/ (gitignored above); keep
# this rule to catch any future tmp-* dropped in root before relocation.
/tmp-*
# 세션 스크래치 디렉터리. `/tmp-*` 만 있어서 `/tmp/` 가 무시되지 않았고, 실측 157MB
# (claude-session-detail.json 단일 파일 144MB)가 `git add -A` 한 번에 커밋될 수 있었다.
/tmp/
# 리포트용 스크린샷 산출물. `report-assets/` 자체에는 추적 중인 알파 PNG 가 있으므로
# 생성물이 쌓이는 하위 디렉터리만 무시한다.
/report-assets/shots/
# 진단·스크래치 산출물. 실측: 정리 시점에 루트/scripts 에 35건(9.5MB)이 쌓여 있었고
# 모두 재생성 가능한 일회용이었다. 개별 삭제로 끝내면 다시 쌓이므로 패턴으로 막는다.
# tsc 전체 출력 덤프
/tsc-full*.txt
# 에이전트 세션 덤프 (claude CLI 가 루트에 흘린다)
/tmpclaude-*
# 일회용 스크립트: scripts/scratch-*.{mts,cjs,py} 21건이 커밋 후보로 올라왔다.
# 보존 가치가 있으면 scratch- 접두사를 떼고 정식 이름으로 커밋한다.
/scripts/scratch-*
# 배경 제거·리포트 생성용 일회용 루트 스크립트
/remove_bg.*
/_fix_report.py
# 에이전트/세션 잡 · 런타임 pid · 파이썬 캐시
.claude/
.gjc/
.codex/
.codex-vite*.pid
.codex-vite*.log
.codex-event-proof*.log
__pycache__/
*.pyc
# 심링크 형태의 node_modules도 차단 (과거 심링크 커밋 사고 — 슬래시 규칙은 디렉터리만 매치)
node_modules
.gjc/

# dev 서버 TLS 자기서명 인증서 (scripts/dev-certs.sh 로 재발급)
.certs/
