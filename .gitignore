# 일회용 프로브·세션 산출물. 실측(2026-08-28): scripts/ 503개 중 60개가 tmp-/scratch-/
# probe-/_ 접두사 일회용이라 모든 glob 에 노이즈를 얹었고, .playwright-cli/ 8건은
# 2026-07-23 세션 잔재였다. 남긴 예외: openwiki 가 감사 하네스로 지목한
# probe-editor-surface.mjs, build-left-sidebar-review-report.mjs 가 spawn 하는 probe 3건,
# src/assets/charsetFaceMap.ts 가 검증 방법으로 인용한 scratch-face-pair/faceset-grid.
/scripts/tmp-*
/scripts/probe-*
!/scripts/probe-editor-surface.mjs
!/scripts/probe-toolbar-clipping.mts
!/scripts/probe-sidebar-keyboard.mts
!/scripts/probe-overflow-dropdown-clip.mts
!/scripts/scratch-face-pair.cjs
!/scripts/scratch-faceset-grid.cjs
/.playwright-cli/

# CC0 BGM release audio: keep binaries/cache outside Git; pin assets/bgm-release-v1.json.
# artifacts/bgm-release/ is already covered by artifacts/ above.
/public/assets/cc0/audio/.bgm-stage-*/
/public/assets/cc0/audio/.bgm-install.lock
# CC0 BGM 카탈로그 오디오. 281곡/약 1.304 GB 는 일반 Git에 담지 않는다 —
# GitHub Release 팩으로 배포하고 assets/bgm-release-v1.json에 검증 정보를 고정한다.
# DigitalOcean CDN은 선택적 스트리밍과 관리자 팩 생성 원본으로 유지한다.
# 예외: 기본 프로젝트가 CDN 없이도 소리를 내야 하므로 스타터 3곡은 추적한다
# (src/assets/bgmStarterTracks.ts 와 짝이며 test/bgmCatalog.test.ts 가 존재를 검사한다).
/public/assets/cc0/audio/catalog/*
!/public/assets/cc0/audio/catalog/rtp-fld-003-amber-meadow-end-final_f5dafd12.mp3
!/public/assets/cc0/audio/catalog/rtp-btl-001-vanguard-signal_fc54007f.mp3
!/public/assets/cc0/audio/catalog/rtp-ttl-001-dawn-guild-ledger_cab8051a.mp3

